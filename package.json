{
  "name": "json-surgeon",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --base-href /json-surgeon/",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "build:cli": "node cli/build.mjs",
    "cli": "node cli/dist/json-surgeon.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.37",
    "@angular/cli": "^20.3.37",
    "@angular/compiler-cli": "^20.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  },
  "description": "Repair broken JSON (LLM output, Python dicts, JS objects, truncated responses), explain every fix, and generate TypeScript, C#, Dart and JSON Schema models. 100% client-side.",
  "author": "Andrésnael Acevedo De La Cruz",
  "license": "MIT",
  "bin": {
    "json-surgeon": "cli/dist/json-surgeon.mjs"
  }
}
